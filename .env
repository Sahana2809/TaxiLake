COMPOSE_PROJECT_NAME=nyc-taxi-de

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=nyc-taxi

POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse123
POSTGRES_DB=taxi_warehouse
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongoadmin123
# 27017 is taken by a pre-existing native MongoDB on this machine; use 27018
# on the host side so this project's container doesn't collide with it.
MONGO_PORT=27018

METABASE_PORT=3000

NIFI_PORT=8443
NIFI_JVM_HEAP_INIT=512m
NIFI_JVM_HEAP_MAX=1g
